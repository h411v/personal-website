---
// Paleta de comandos (Ctrl+K / ⌘K / "/") + atalhos estilo Vim + ajuda ("?").
import { cv } from '../data/cv';
import { getNotes, getPosts, noteSlug, postSlug } from '../lib/content';
import { formatDate, formatDay } from '../lib/date';
import { localizePath, t, type Lang, type UIKey } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const other: Lang = lang === 'en' ? 'pt' : 'en';
const path = (p: string) => localizePath(p, lang);

// Texto puro a partir do Markdown de uma nota (para a busca)
const plain = (md = '') =>
  md
    .replace(/```[\s\S]*?```/g, ' ')
    .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
    .replace(/[`*_>#]/g, '')
    .replace(/\s+/g, ' ')
    .trim();
const clip = (text: string, max = 90) => (text.length > max ? `${text.slice(0, max - 1)}…` : text);

// Atalhos "g + tecla"
const goto = [
  { key: 'h', href: path('/'), label: 'nav.home' },
  { key: 'b', href: path('/blog'), label: 'nav.blog' },
  { key: 'n', href: path('/notes'), label: 'nav.notes' },
  { key: 'p', href: path('/portfolio'), label: 'nav.portfolio' },
  { key: 'a', href: path('/about'), label: 'nav.about' },
  { key: 'u', href: path('/uses'), label: 'nav.uses' },
] satisfies { key: string; href: string; label: UIKey }[];

type Item = {
  group: 'pages' | 'actions' | 'posts' | 'notes';
  label: string;
  hint?: string;
  keys?: string;
  href?: string;
  external?: boolean;
  action?: 'theme' | 'lang' | 'email';
};

const items: Item[] = [
  ...goto.map((g) => ({
    group: 'pages' as const,
    label: t(lang, g.label),
    hint: g.href,
    keys: `g ${g.key}`,
    href: g.href,
  })),
  { group: 'pages', label: 'rss', hint: path('/rss'), href: path('/rss') },
  { group: 'actions', label: t(lang, 'cmd.theme'), keys: 't', action: 'theme' },
  { group: 'actions', label: t(lang, 'cmd.lang'), hint: other, keys: 'l', action: 'lang' },
  { group: 'actions', label: t(lang, 'cmd.email'), hint: cv.contact.email, action: 'email' },
  { group: 'actions', label: 'GitHub', hint: 'h411v ↗', href: cv.contact.github, external: true },
  ...(await getPosts(lang)).map((post) => ({
    group: 'posts' as const,
    label: post.data.title,
    hint: formatDate(post.data.date),
    href: path(`/blog/${postSlug(post)}`),
  })),
  ...(await getNotes(lang)).map((note) => ({
    group: 'notes' as const,
    label: clip(plain(note.body)),
    hint: formatDay(note.data.date),
    href: `${path('/notes')}#${noteSlug(note)}`,
  })),
];

const groups = {
  pages: t(lang, 'cmd.pages'),
  actions: t(lang, 'cmd.actions'),
  posts: t(lang, 'cmd.posts'),
  notes: t(lang, 'cmd.notes'),
};

// JSON seguro dentro de <script> (escapa "<")
const data = JSON.stringify({
  items,
  groups,
  goto: Object.fromEntries(goto.map((g) => [g.key, g.href])),
  copied: t(lang, 'cmd.copied'),
}).replace(/</g, '\\u003c');

const shortcuts: { keys: string[]; label: UIKey }[] = [
  { keys: ['Ctrl K', '/'], label: 'keys.palette' },
  { keys: ['g h'], label: 'keys.home' },
  { keys: ['g b'], label: 'keys.blog' },
  { keys: ['g n'], label: 'keys.notes' },
  { keys: ['g p'], label: 'keys.portfolio' },
  { keys: ['g a'], label: 'keys.about' },
  { keys: ['g u'], label: 'keys.uses' },
  { keys: ['j', 'k'], label: 'keys.scroll' },
  { keys: ['d', 'u'], label: 'keys.halfPage' },
  { keys: ['g g', 'G'], label: 'keys.topBottom' },
  { keys: ['t'], label: 'keys.theme' },
  { keys: ['l'], label: 'keys.lang' },
  { keys: ['?'], label: 'keys.help' },
];
---

<script is:inline type="application/json" id="cmd-data" set:html={data} />

<!-- Paleta -->
<dialog
  id="cmd"
  aria-label={t(lang, 'cmd.open')}
  class="cmd-dialog m-0 mx-auto mt-[12vh] w-[calc(100%-2rem)] max-w-xl overflow-hidden rounded-xl border border-border bg-bg p-0 text-text shadow-2xl"
>
  <div class="flex items-center gap-3 border-b border-border px-4">
    <span aria-hidden="true" class="font-mono text-sm text-subtle">❯</span>
    <input
      id="cmd-input"
      type="text"
      autocomplete="off"
      spellcheck="false"
      placeholder={t(lang, 'cmd.placeholder')}
      aria-controls="cmd-list"
      class="h-12 w-full bg-transparent text-[15px] text-fg outline-none placeholder:text-muted"
    />
    <kbd class="kbd">esc</kbd>
  </div>
  <ul id="cmd-list" role="listbox" class="max-h-[min(60vh,26rem)] overflow-y-auto p-2"></ul>
  <p id="cmd-empty" hidden class="px-4 pt-2 pb-6 text-center text-sm text-muted">
    {t(lang, 'cmd.empty')}
  </p>
  <p
    class="flex flex-wrap gap-x-3 border-t border-border px-4 py-2.5 font-mono text-[11px] text-muted"
  >
    {t(lang, 'cmd.footer')}
  </p>
</dialog>

<!-- Ajuda dos atalhos -->
<dialog
  id="keys-help"
  aria-labelledby="keys-help-title"
  class="cmd-dialog m-0 mx-auto mt-[12vh] w-[calc(100%-2rem)] max-w-md rounded-xl border border-border bg-bg p-0 text-text shadow-2xl"
>
  <div class="flex items-center justify-between border-b border-border px-5 py-3.5">
    <h2 id="keys-help-title" class="text-sm font-medium text-fg">{t(lang, 'keys.title')}</h2>
    <kbd class="kbd">esc</kbd>
  </div>
  <dl class="grid grid-cols-[auto_1fr] items-center gap-x-6 gap-y-2.5 px-5 py-4 text-sm">
    {
      shortcuts.map((s) => (
        <>
          <dt class="flex gap-1.5">
            {s.keys.map((k) => (
              <kbd class="kbd">{k}</kbd>
            ))}
          </dt>
          <dd class="text-muted">{t(lang, s.label)}</dd>
        </>
      ))
    }
  </dl>
</dialog>

<!-- Indicador de tecla pendente, como o "showcmd" do Vim -->
<div
  id="showcmd"
  aria-hidden="true"
  hidden
  class="fixed right-4 bottom-4 z-50 rounded-md border border-border bg-surface px-2.5 py-1 font-mono text-xs text-fg shadow-lg"
>
</div>

<style is:global>
  .kbd {
    display: inline-flex;
    align-items: center;
    min-width: 1.4rem;
    justify-content: center;
    padding: 0.1rem 0.4rem;
    border: 1px solid var(--border);
    border-bottom-width: 2px;
    border-radius: 0.3rem;
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.4;
    color: var(--muted);
    white-space: nowrap;
  }
  .cmd-dialog::backdrop {
    background: rgb(0 0 0 / 0.45);
    backdrop-filter: blur(3px);
  }
  .cmd-dialog[open] {
    animation: cmd-in 0.14s ease-out;
  }
  .cmd-dialog:focus-visible {
    outline: none;
  }
  @keyframes cmd-in {
    from {
      opacity: 0;
      transform: translateY(-6px) scale(0.98);
    }
  }
  #cmd-list [aria-selected='true'] {
    background: var(--surface);
    color: var(--fg);
  }
  #cmd-list [aria-selected='true'] .cmd-arrow {
    opacity: 1;
  }
</style>

<script>
  type Item = {
    group: 'pages' | 'actions' | 'posts' | 'notes';
    label: string;
    hint?: string;
    keys?: string;
    href?: string;
    external?: boolean;
    action?: 'theme' | 'lang' | 'email';
  };

  const { items, groups, goto, copied } = JSON.parse(
    document.getElementById('cmd-data')!.textContent!,
  ) as {
    items: Item[];
    groups: Record<Item['group'], string>;
    goto: Record<string, string>;
    copied: string;
  };

  const dialog = document.getElementById('cmd') as HTMLDialogElement;
  const help = document.getElementById('keys-help') as HTMLDialogElement;
  const input = document.getElementById('cmd-input') as HTMLInputElement;
  const list = document.getElementById('cmd-list') as HTMLUListElement;
  const empty = document.getElementById('cmd-empty') as HTMLParagraphElement;
  const showcmd = document.getElementById('showcmd') as HTMLDivElement;

  const ORDER: Item['group'][] = ['pages', 'actions', 'posts', 'notes'];
  const normalize = (s: string) =>
    s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();

  let results: Item[] = [];
  let active = 0;

  // ---------- Paleta ----------

  function render() {
    const words = normalize(input.value).split(/\s+/).filter(Boolean);
    const matches = items.filter((item) => {
      const haystack = normalize(`${item.label} ${item.hint ?? ''} ${groups[item.group]}`);
      return words.every((w) => haystack.includes(w));
    });

    // Sem busca: limita posts e notas para a lista não ficar enorme
    results = [];
    for (const group of ORDER) {
      const inGroup = matches.filter((m) => m.group === group);
      results.push(...(words.length || group === 'pages' || group === 'actions' ? inGroup : inGroup.slice(0, 5)));
    }
    active = 0;

    list.replaceChildren();
    let lastGroup = '';
    results.forEach((item, index) => {
      if (item.group !== lastGroup) {
        lastGroup = item.group;
        const heading = document.createElement('li');
        heading.setAttribute('role', 'presentation');
        heading.className = 'px-2.5 pt-3 pb-1.5 font-mono text-[11px] text-subtle first:pt-1';
        heading.textContent = groups[item.group];
        list.append(heading);
      }

      const li = document.createElement('li');
      li.id = `cmd-item-${index}`;
      li.setAttribute('role', 'option');
      li.dataset.index = String(index);
      li.className =
        'flex cursor-pointer items-center gap-3 rounded-lg px-2.5 py-2 text-sm text-text';

      const label = document.createElement('span');
      label.className = 'min-w-0 flex-1 truncate';
      label.textContent = item.label;

      const hint = document.createElement('span');
      hint.className = 'cmd-hint shrink-0 font-mono text-[11px] text-muted';
      hint.textContent = item.hint ?? '';

      li.append(label, hint);

      if (item.keys) {
        const kbd = document.createElement('kbd');
        kbd.className = 'kbd hidden sm:inline-flex';
        kbd.textContent = item.keys;
        li.append(kbd);
      }

      const arrow = document.createElement('span');
      arrow.className = 'cmd-arrow font-mono text-xs text-accent opacity-0';
      arrow.textContent = '↵';
      li.append(arrow);

      list.append(li);
    });

    empty.hidden = results.length > 0;
    highlight();
  }

  function highlight() {
    list.querySelectorAll('[role="option"]').forEach((el) => {
      el.setAttribute('aria-selected', String(Number((el as HTMLElement).dataset.index) === active));
    });
    const current = document.getElementById(`cmd-item-${active}`);
    current?.scrollIntoView({ block: 'nearest' });
    input.setAttribute('aria-activedescendant', current?.id ?? '');
  }

  function move(delta: number) {
    if (!results.length) return;
    active = (active + delta + results.length) % results.length;
    highlight();
  }

  function openPalette() {
    if (help.open) help.close();
    if (dialog.open) return;
    input.value = '';
    render();
    dialog.showModal();
    input.focus();
  }

  async function run(item: Item | undefined) {
    if (!item) return;
    if (item.action === 'theme') {
      dialog.close();
      document.querySelector<HTMLButtonElement>('[data-theme-toggle]')?.click();
      return;
    }
    if (item.action === 'lang') {
      switchLanguage();
      return;
    }
    if (item.action === 'email') {
      try {
        await navigator.clipboard.writeText(item.hint ?? '');
        const hint = document.querySelector(`#cmd-item-${active} .cmd-hint`);
        if (hint) hint.textContent = copied;
        setTimeout(() => dialog.close(), 700);
      } catch {
        location.href = `mailto:${item.hint}`;
      }
      return;
    }
    if (item.href) {
      dialog.close();
      if (item.external) window.open(item.href, '_blank', 'noopener');
      else location.href = item.href;
    }
  }

  function switchLanguage() {
    // Usa o link do seletor de idioma do header (já sabe para onde levar)
    const link = document.querySelector<HTMLAnchorElement>('header a[hreflang]:not([aria-current])');
    if (link) location.href = link.href;
  }

  input.addEventListener('input', render);
  input.addEventListener('keydown', (e) => {
    const key = e.key.toLowerCase();
    if (e.key === 'ArrowDown' || (e.ctrlKey && (key === 'j' || key === 'n'))) {
      e.preventDefault();
      move(1);
    } else if (e.key === 'ArrowUp' || (e.ctrlKey && (key === 'k' || key === 'p'))) {
      e.preventDefault();
      move(-1);
    } else if (e.key === 'Enter') {
      e.preventDefault();
      run(results[active]);
    }
  });
  list.addEventListener('pointermove', (e) => {
    const li = (e.target as HTMLElement).closest<HTMLElement>('[role="option"]');
    if (li && Number(li.dataset.index) !== active) {
      active = Number(li.dataset.index);
      highlight();
    }
  });
  list.addEventListener('click', (e) => {
    const li = (e.target as HTMLElement).closest<HTMLElement>('[role="option"]');
    if (li) run(results[Number(li.dataset.index)]);
  });
  // Clique fora da caixa fecha
  for (const d of [dialog, help]) {
    d.addEventListener('click', (e) => {
      if (e.target === d) d.close();
    });
  }

  document.querySelectorAll('[data-palette-open]').forEach((el) =>
    el.addEventListener('click', openPalette),
  );
  document.querySelectorAll('[data-help-open]').forEach((el) =>
    el.addEventListener('click', () => {
      if (dialog.open) dialog.close();
      help.showModal();
    }),
  );

  // Mostra "Ctrl K" ou "⌘K" conforme o sistema
  const isMac = /Mac|iPhone|iPad/.test(navigator.platform);
  document.querySelectorAll('[data-palette-key]').forEach((el) => {
    el.textContent = isMac ? '⌘K' : 'Ctrl K';
  });

  // ---------- Atalhos Vim ----------

  let pending = '';
  let pendingTimer = 0;

  const setPending = (key: string) => {
    pending = key;
    showcmd.textContent = key;
    showcmd.hidden = !key;
    clearTimeout(pendingTimer);
    if (key) pendingTimer = window.setTimeout(() => setPending(''), 1200);
  };

  const isTyping = (target: EventTarget | null) => {
    const el = target as HTMLElement | null;
    return !!el && (el.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(el.tagName));
  };

  const scroll = (top: number) => window.scrollBy({ top, behavior: 'smooth' });

  document.addEventListener('keydown', (e) => {
    // Ctrl+K / ⌘K abre (ou fecha) a paleta de qualquer lugar
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k' && !dialog.open) {
      e.preventDefault();
      openPalette();
      return;
    }

    if (dialog.open || help.open || isTyping(e.target)) return;
    if (e.ctrlKey || e.metaKey || e.altKey) return;

    const key = e.key;

    if (pending === 'g') {
      setPending('');
      if (key === 'g') {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      } else if (goto[key]) {
        location.href = goto[key];
      }
      e.preventDefault();
      return;
    }

    switch (key) {
      case 'g':
        setPending('g');
        break;
      case '/':
        openPalette();
        break;
      case '?':
        help.showModal();
        break;
      case 'j':
        scroll(120);
        break;
      case 'k':
        scroll(-120);
        break;
      case 'd':
        scroll(window.innerHeight / 2);
        break;
      case 'u':
        scroll(-window.innerHeight / 2);
        break;
      case 'G':
        window.scrollTo({ top: document.documentElement.scrollHeight, behavior: 'smooth' });
        break;
      case 't':
        document.querySelector<HTMLButtonElement>('[data-theme-toggle]')?.click();
        break;
      case 'l':
        switchLanguage();
        break;
      default:
        return;
    }
    e.preventDefault();
  });
</script>
