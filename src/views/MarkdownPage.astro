---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { getPage } from '../lib/content';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  name: 'about' | 'uses';
}

const { lang, name } = Astro.props;
const page = await getPage(lang, name);
const { Content } = await render(page);
---

<BaseLayout lang={lang} title={page.data.title} description={page.data.description}>
  <PageHeader title={page.data.title} description={page.data.description} />
  <article class="prose">
    <Content />
  </article>
</BaseLayout>
