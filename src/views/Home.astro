---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Sep from '../components/Sep.astro';
import NowPlaying from '../components/NowPlaying.astro';
import DitherPlanet from '../components/DitherPlanet.astro';
import { profile } from '../data/profile';
import { getNotes, getPosts, noteSlug, postSlug } from '../lib/content';
import { formatDate, formatDay, formatTime } from '../lib/date';
import { localizePath, t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const posts = (await getPosts(lang)).slice(0, 5);
const notes = await Promise.all(
  (await getNotes(lang))
    .slice(0, 3)
    .map(async (note) => ({ note, Content: (await render(note)).Content })),
);
---

<BaseLayout lang={lang} description={profile.bio[lang]}>
  <section>
    <div class="grid grid-cols-[1fr_auto] items-center gap-x-6 sm:items-start">
      <h1 class="text-2xl font-medium tracking-tight sm:mt-1 sm:text-[1.75rem]">
        <span class="fx">{profile.name}</span>
      </h1>
      <DitherPlanet class="-my-6 size-28 sm:row-span-2 sm:my-0 sm:-mt-4 sm:size-42" />
      <p class="col-span-2 mt-4 max-w-[34rem] text-pretty sm:col-span-1">{profile.bio[lang]}</p>
    </div>

    <dl class="mt-8 grid grid-cols-[6.5rem_1fr] gap-y-1.5 font-mono text-[13px]">
      {
        profile.facts.map((fact) => (
          <>
            <dt class="text-muted">{fact.label[lang]}</dt>
            <dd class="text-fg">{fact.value[lang]}</dd>
          </>
        ))
      }
    </dl>

    <NowPlaying lang={lang} />

    <a
      href={localizePath('/uses', lang)}
      class="mt-6 inline-flex items-center gap-1.5 font-mono text-[13px] text-accent transition-opacity hover:opacity-75"
    >
      {t(lang, 'home.setup')} →
    </a>
  </section>

  {
    posts.length > 0 && (
      <section class="mt-16 sm:mt-20">
        <SectionHeader
          title={t(lang, 'home.latestPosts')}
          href={localizePath('/blog', lang)}
          linkLabel={t(lang, 'home.allPosts')}
        />
        <ul class="-mx-3">
          {posts.map((post) => (
            <li>
              <a
                href={localizePath(`/blog/${postSlug(post)}`, lang)}
                class="group flex items-baseline justify-between gap-6 rounded-md px-3 py-2.5 transition-colors hover:bg-surface"
              >
                <span class="text-text transition-colors group-hover:text-fg">
                  {post.data.title}
                </span>
                <time
                  datetime={post.data.date.toISOString()}
                  class="shrink-0 font-mono text-xs text-muted"
                >
                  {formatDate(post.data.date)}
                </time>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    notes.length > 0 && (
      <section class="mt-16 sm:mt-20">
        <SectionHeader
          title={t(lang, 'home.latestNotes')}
          href={localizePath('/notes', lang)}
          linkLabel={t(lang, 'home.allNotes')}
        />
        <ul class="divide-y divide-border">
          {notes.map(({ note, Content }) => (
            <li class="py-4 first:pt-1">
              <a
                href={`${localizePath('/notes', lang)}#${noteSlug(note)}`}
                class="flex items-center gap-2 font-mono text-xs text-muted transition-colors hover:text-fg"
              >
                <time datetime={note.data.date.toISOString()}>{formatDay(note.data.date)}</time>
                <Sep />
                <span>{formatTime(note.data.date)}</span>
              </a>
              <div class="home-note mt-1.5 line-clamp-2 text-text">
                <Content />
              </div>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>

<style>
  /* Na prévia, os parágrafos da nota viram uma linha corrida (cortada em 2 linhas) */
  .home-note :global(p) {
    display: inline;
  }
  .home-note :global(p + p)::before {
    content: ' ';
  }
  .home-note :global(a) {
    color: var(--accent);
  }
  .home-note :global(code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
  }
</style>
