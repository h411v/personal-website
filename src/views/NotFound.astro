---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sep from '../components/Sep.astro';
import { localizePath, t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const links = [
  { href: '/', label: t(lang, 'nav.home') },
  { href: '/blog', label: t(lang, 'nav.blog') },
  { href: '/notes', label: t(lang, 'nav.notes') },
  { href: '/portfolio', label: t(lang, 'nav.portfolio') },
];
---

<BaseLayout lang={lang} title="404" description={t(lang, 'notFound.title')} noindex>
  <section class="py-4 sm:py-10">
    <p class="flex flex-wrap items-center gap-x-2.5 font-mono text-xs text-muted">
      <span>{t(lang, 'notFound.error')} 404</span>
      <Sep />
      <span data-missing-path class="break-all text-subtle"></span>
    </p>

    <h1 class="mt-5 text-[5.5rem] leading-none font-medium tracking-tighter text-fg sm:text-[7rem]">
      404
    </h1>

    <h2 class="mt-8 text-xl font-medium tracking-tight text-fg">{t(lang, 'notFound.title')}</h2>
    <p class="mt-3 max-w-[32rem] text-pretty text-muted">{t(lang, 'notFound.text')}</p>

    <nav class="mt-10 flex flex-wrap items-center gap-x-2.5 gap-y-1 font-mono text-xs">
      {
        links.map((link, i) => (
          <>
            {i > 0 && <Sep />}
            <a
              href={localizePath(link.href, lang)}
              class={
                i === 0
                  ? 'text-accent transition-opacity hover:opacity-75'
                  : 'text-muted transition-colors hover:text-fg'
              }
            >
              {i === 0 && '← '}
              {link.label}
            </a>
          </>
        ))
      }
    </nav>
  </section>
</BaseLayout>

<script>
  // Mostra o endereço que a pessoa tentou abrir
  const el = document.querySelector('[data-missing-path]');
  if (el) el.textContent = decodeURIComponent(location.pathname);
</script>
